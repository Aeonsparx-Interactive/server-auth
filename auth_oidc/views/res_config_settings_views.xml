<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.auth.oidc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="module_auth_oauth" position="after">
                <div class="col-12 col-lg-6 o_setting_box"
                    id="auth_oidc_hide_email_login_setting"
                    attrs="{'invisible': [('module_auth_oauth','=',False)]}">
                    <div class="o_setting_left_pane">
                        <field name="auth_oidc_hide_email_login"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label string="Hide Email Login" for="auth_oidc_hide_email_login"/>
                        <div class="text-muted">
                            Hide the email/password login form on the login screen.
                            Users can only sign in through the OAuth provider buttons.
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>
</odoo>
