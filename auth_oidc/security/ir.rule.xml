<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Regular users may only manage their own OAuth accounts. -->
    <record id="rule_auth_oauth_account_own" model="ir.rule">
        <field name="name">auth.oauth.account: own accounts only</field>
        <field name="model_id" ref="model_auth_oauth_account" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
    </record>
    <!-- Administrators may manage all OAuth accounts. -->
    <record id="rule_auth_oauth_account_admin" model="ir.rule">
        <field name="name">auth.oauth.account: admin all</field>
        <field name="model_id" ref="model_auth_oauth_account" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
